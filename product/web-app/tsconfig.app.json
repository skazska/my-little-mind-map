{
  "compilerOptions": {
    // Incremental build cache for "tsc -b". Stored in node_modules to avoid
    // polluting the source tree.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Required for TypeScript project references — enables incremental builds
    // and allows the root tsconfig to reference this one.
    "composite": true,
    // ── Target ───────────────────────────────────────────────────────────────
    // Modern browsers and Vite's esbuild pipeline support ES2023 natively.
    "target": "ES2023",
    // ES2023 already includes DOM.Iterable so no extra lib entry needed.
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    // Type Vite env globals (import.meta.env, import.meta.hot, etc.)
    // without needing /// <reference types="vite/client" /> in every file.
    "types": [
      "vite/client"
    ],
    // Skip type-checking of .d.ts files in node_modules. Safe standard practice.
    "skipLibCheck": true,
    // ── Bundler mode ─────────────────────────────────────────────────────────
    // Resolve imports the way Vite (esbuild/rollup) does, not Node.js resolution.
    "moduleResolution": "bundler",
    // Allow explicit .ts/.tsx extensions in import paths (required by bundler
    // resolution — the bundler strips them to .js at build time).
    "allowImportingTsExtensions": true,
    // Allow JSON imports: import data from './data.json'.
    "resolveJsonModule": true,
    // TS 5.0+ replacement for "isolatedModules". Enforces "import type" for
    // type-only imports so esbuild can safely erase them in a single-file pass
    // without a full type-checker run. Also implies allowSyntheticDefaultImports.
    "verbatimModuleSyntax": true,
    // Treat every file as an ES module even without import/export statements.
    // Prevents accidental global-scope pollution in a bundled project.
    "moduleDetection": "force",
    // Don't emit JS — Vite handles all transpilation and bundling.
    "noEmit": true,
    // React 17+ JSX transform: no need to import React in every file.
    "jsx": "react-jsx",
    // ── Linting ───────────────────────────────────────────────────────────────
    // Enables ~15 strict sub-flags in one: strictNullChecks, noImplicitAny,
    // strictFunctionTypes, strictPropertyInitialization, etc.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // TS 5.5+: disallow const enum and legacy namespace syntax. Guarantees all
    // syntax is safely erasable by esbuild without a full TS parse step.
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ]
}